{
  "skillListingBudgetFraction": 0.05,
  "env": {
    "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Program Files\\Git\\bin\\bash.exe",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__tabs_context_mcp",
      "PowerShell(*Get-FileHash*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "company-research": "off",
    "web-search-advanced-research-paper": "off",
    "code-search-exa": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/destructive-command-gate.js"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/suggest-compact.js"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/suggest-compact.js"
          }
        ]
      },
      {
        "matcher": "^mcp__mcp-atlassian__(confluence_(create_page|create_page_from_template|update_page|update_page_section|add_comment|add_inline_comment|reply_to_comment)|jira_(create_issue|batch_create_issues|update_issue|add_comment|edit_comment|create_customer_request|transition_issue))$|^mcp__claude_ai_Slack__slack_(send_message|send_message_draft|schedule_message|create_canvas|update_canvas)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/dadeumi-gate.js"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/dadeumi-gate.js",
            "if": "Bash(gws *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/dadeumi-gate.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/py-encoding-check.js"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/reset-compact-counters.js"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "/c/Users/YOUR_USERNAME/.claude/statusline-bash.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "ralph-loop@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": false,
    "insane-search@gptaku-plugins": true,
    "example-skills@anthropic-agent-skills": false,
    "code-simplifier@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "stitch-build@google-labs-code-stitch-skills": false,
    "stitch-design@google-labs-code-stitch-skills": false,
    "stitch-utilities@google-labs-code-stitch-skills": false,
    "sentry@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "firecrawl@anthropic-plugin-directory": true,
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "exa-skills": {
      "source": {
        "source": "github",
        "repo": "benjaminjackson/exa-skills"
      }
    },
    "Claudest": {
      "source": {
        "source": "github",
        "repo": "gupsammy/claudest"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-for-financial-services": {
      "source": {
        "source": "github",
        "repo": "anthropics/financial-services"
      }
    },
    "gptaku-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/fivetaku/gptaku_plugins.git"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "language": "Korean",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5": {
      "effortLevel": "medium"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "switchModelsOnFlag": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
