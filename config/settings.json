{
  "skillListingBudgetFraction": 0.05,
  "env": {
    "CLAUDE_CODE_GIT_BASH_PATH": "C:\\Program Files\\Git\\bin\\bash.exe",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__tabs_context_mcp",
      "PowerShell(*Get-FileHash*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "/c/Users/YOUR_USERNAME/.claude/statusline-bash.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "superpowers@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "ralph-loop@claude-plugins-official": false,
    "cloudflare@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "insane-search@gptaku-plugins": true,
    "example-skills@anthropic-agent-skills": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "exa-skills": {
      "source": {
        "source": "github",
        "repo": "benjaminjackson/exa-skills"
      }
    },
    "Claudest": {
      "source": {
        "source": "github",
        "repo": "gupsammy/claudest"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "claude-for-financial-services": {
      "source": {
        "source": "github",
        "repo": "anthropics/financial-services"
      }
    },
    "gptaku-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/fivetaku/gptaku_plugins.git"
      }
    }
  },
  "language": "Korean",
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/suggest-compact.js"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/suggest-compact.js"
          }
        ]
      },
      {
        "matcher": "^mcp__mcp-atlassian__(confluence_(create_page|create_page_from_template|update_page|update_page_section|add_comment|add_inline_comment|reply_to_comment)|jira_(create_issue|batch_create_issues|update_issue|add_comment|edit_comment|create_customer_request|transition_issue))$|^mcp__claude_ai_Slack__slack_(send_message|send_message_draft|schedule_message|create_canvas|update_canvas)$",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/public-writing-gate.js"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/public-writing-gate.js",
            "if": "Bash(gws *)"
          },
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/public-writing-gate.js",
            "if": "Bash(gh *)"
          },
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/public-writing-gate.js",
            "if": "PowerShell(*gws *)"
          },
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/public-writing-gate.js",
            "if": "PowerShell(*gh *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/public-writing-gate.js"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/scripts/hooks/reset-compact-counters.js"
          }
        ]
      }
    ]
  }
}
